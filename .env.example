# Copie ce fichier en ".env" et adapte les valeurs.

# Port d'écoute du dashboard
PORT=4200

# --- Compte admin initial ------------------------------------------------
# Utilisés UNE SEULE FOIS, au tout premier démarrage, pour créer le compte
# administrateur (si la base d'utilisateurs est vide). Ensuite, la gestion
# des comptes se fait depuis l'UI (menu utilisateurs, admin uniquement) ou
# via `node bin/manage-users.js`. Ces variables peuvent être retirées du
# .env après le premier lancement, elles ne servent plus.
PM2_MONITOR_USER=admin
PM2_MONITOR_PASS=change-moi

# Pour désactiver complètement l'auth (déconseillé si le port est exposé) :
# PM2_MONITOR_DISABLE_AUTH=1

# Secret de signature des cookies de session. À définir explicitement en
# production (sinon un secret aléatoire est généré à chaque redémarrage,
# ce qui déconnecte tout le monde à chaque restart du process).
SESSION_SECRET=change-moi-aussi

# Passe à 1 si le dashboard est servi en HTTPS (cookies "secure")
# SESSION_COOKIE_SECURE=1

# Clé de chiffrement (AES-256-GCM) des secrets de providers de
# notification (mot de passe SMTP, webhook Discord/Slack, bot token
# Telegram…). Accepte n'importe quelle chaîne (dérivée en 32 octets via
# SHA-256). Si absente, une clé aléatoire est générée en mémoire au
# démarrage (avertissement affiché) : tout secret déjà stocké devient
# alors illisible au prochain redémarrage. Voir docs/notifications/README.md.
NOTIFICATIONS_ENCRYPTION_KEY=change-moi-egalement

# --- Base de données (comptes / permissions) ------------------------------
# DB_DRIVER=sqlite (par défaut) : fichier local, zéro dépendance externe,
# recommandé pour la grande majorité des installations.
DB_DRIVER=sqlite
# Chemin du fichier SQLite (par défaut : ./data/monitor.db)
# DB_SQLITE_PATH=./data/monitor.db

# DB_DRIVER=mysql : pour centraliser users/permissions dans un serveur
# MySQL/MariaDB existant. Décommente et adapte, puis installe la dépendance
# optionnelle avec `npm install mysql2` si elle n'est pas déjà présente.
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=pm2_monitor
# DB_PASS=change-moi
# DB_NAME=pm2_monitor

# --- Moteur d'alertes (lib/services/alerts/) ------------------------------
# Active/désactive le moteur d'alertes (1 = activé, 0 = désactivé).
# ALERTS_ENABLED=1

# Intervalle d'évaluation des règles d'alerte (en ms, par défaut 15s).
# ALERTS_EVAL_INTERVAL_MS=15000

# Dispatch des notifications sur transition d'alerte (routing par règles,
# Phase 5D — voir docs/notifications/README.md#routing-phase-5d). 1 =
# activé, 0 = désactivé. Indépendant de ALERTS_ENABLED : permet de couper
# uniquement l'envoi de notifications (debug, incident fournisseur) sans
# désactiver le moteur d'alertes lui-même. Sans effet si ALERTS_ENABLED=0.
# NOTIFICATIONS_DISPATCH_ENABLED=1

# --- Historique des processus (lib/services/process-history/) -------------
# Active/désactive l'historique des processus (1 = activé, 0 = désactivé).
# PROCESS_HISTORY_ENABLED=1

# Intervalle de collecte des données d'historique (en ms, par défaut 15s).
# PROCESS_HISTORY_COLLECT_INTERVAL_MS=15000

# Intervalle de maintenance de l'historique (en ms, par défaut 1h).
# PROCESS_HISTORY_MAINTENANCE_INTERVAL_MS=3600000

# Période de rétention des données petites (en ms, par défaut 1h).
# PROCESS_HISTORY_SHORT_RETENTION_MS=3600000

# Période de rétention des données moyennes (en ms, par défaut 30j).
# PROCESS_HISTORY_MEDIUM_RETENTION_MS=2592000000

# Période de rétention des données longues (en ms, par défaut 90j).
# PROCESS_HISTORY_LONG_RETENTION_MS=7776000000

# Période de bucket des données moyennes (en ms, par défaut 30j).
# PROCESS_HISTORY_MEDIUM_BUCKET_MS=2592000000

# Période de bucket des données longues (en ms, par défaut 90j).
# PROCESS_HISTORY_LONG_BUCKET_MS=7776000000

# Période de rétention des données raw max span (en ms, par défaut 6h).
# PROCESS_HISTORY_RAW_MAX_SPAN_MS=21600000

# Période de rétention des données medium max span (en ms, par défaut 30j).
# PROCESS_HISTORY_MEDIUM_MAX_SPAN_MS=2592000000

# Nombre maximum de points de données dans une réponse API (par défaut 500).
# PROCESS_HISTORY_MAX_POINTS=500

# --- Timeline d'événements (lib/services/events/) --------------------------
# Active/désactive la timeline d'événements PM2 (1 = activé, 0 = désactivé).
# EVENTS_ENABLED=1

# Durée de conservation des événements avant purge automatique (en ms, par défaut 90j).
# EVENTS_RETENTION_MS=7776000000

# Intervalle du cycle de purge (en ms, par défaut 1h).
# EVENTS_MAINTENANCE_INTERVAL_MS=3600000

# --- Health checks (lib/services/health-checks/, Phase 6) -----------------
# Active/désactive le scheduler de health checks (1 = activé, 0 = désactivé).
# L'API de gestion des checks (CRUD, run test) reste disponible même à 0 ;
# seule l'exécution automatique périodique est coupée.
# HEALTH_CHECKS_ENABLED=1

# Fréquence (ms) à laquelle le scheduler regarde quels checks sont dus
# (compare à l'intervalle propre à chaque check, pas une fréquence
# d'exécution globale). Par défaut 5000 (5s).
# HEALTH_CHECKS_SCHEDULER_INTERVAL_MS=5000

# --- Audit Log (lib/services/audit/, Phase 9) ------------------------------
# Durée de conservation des entrées d'audit avant purge automatique (en ms).
# 0 (par défaut) = purge désactivée, rien n'est jamais supprimé — choix le
# plus sûr pour un journal de conformité/sécurité. Ne définir que si une
# politique de rétention explicite est voulue, ex: 1 an = 31536000000.
# AUDIT_RETENTION_MS=0

# Intervalle du cycle de purge, si AUDIT_RETENTION_MS est défini (en ms, par défaut 1h).
# AUDIT_MAINTENANCE_INTERVAL_MS=3600000

# --- Multi-server / Remote PM2 (lib/services/servers/, lib/realtime/agent-hub.js, Phase 10) ---
# Nom affiché pour le serveur local dans l'onglet Serveurs (par défaut "Serveur local").
# PM2_MONITOR_LOCAL_SERVER_NAME=Serveur local

# Intervalle de heartbeat attendu d'un agent distant (en ms, par défaut 10s).
# Doit être identique côté hub (ce .env) et côté agent (voir bin/agent.js).
# AGENT_HEARTBEAT_INTERVAL_MS=10000

# Délai sans heartbeat avant de considérer un agent OFFLINE (en ms, par défaut 3x l'intervalle).
# AGENT_HEARTBEAT_TIMEOUT_MS=30000

# Intervalle du balayage périodique qui bascule OFFLINE les serveurs dont le
# heartbeat a expiré (en ms, par défaut 5s).
# AGENT_STALE_SWEEP_INTERVAL_MS=5000

# Délai d'attente d'un accusé de réception pour une action distante
# (start/stop/restart/reload) avant de la considérer perdue (en ms, par défaut 15s).
# AGENT_ACTION_ACK_TIMEOUT_MS=15000

# --- Prometheus Metrics Export (lib/services/metrics/, lib/routes/metrics.js, Phase 15) ---
# Active/désactive complètement l'endpoint GET /metrics (1 = activé, 0 = désactivé).
# METRICS_ENABLED=1

# Jeton d'authentification pour /metrics (en-tête "Authorization: Bearer <token>").
# Si défini, requis pour toute requête (sauf IP explicitement autorisée en plus, voir
# METRICS_ALLOWED_IPS). Recommandé si Prometheus scrape depuis une autre machine.
# METRICS_TOKEN=

# Liste d'IP autorisées à interroger /metrics, séparées par des virgules
# (comparaison exacte sur l'IP de la requête, cf. `trust proxy` dans server.js).
# Si absente ET qu'aucun METRICS_TOKEN n'est défini, seul l'hôte local
# (127.0.0.1/::1) peut interroger l'endpoint — voir docs/metrics/README.md#sécurité.
# METRICS_ALLOWED_IPS=127.0.0.1,10.0.0.5

# --- Détection d'anomalies (lib/services/anomaly-detection/, Phase 16) ----
# Active/désactive l'évaluation des règles de détection d'anomalies
# (1 = activé, 0 = désactivé). Indépendant du fait qu'une règle existe ou
# non : coupe uniquement la boucle d'évaluation, l'API de gestion des
# règles (CRUD) reste disponible même à 0. Les règles elles-mêmes
# (sensibilité/fenêtre/cooldown/métriques) se configurent via l'API REST,
# voir docs/anomaly-detection/README.md.
# ANOMALY_DETECTION_ENABLED=1

# --- Agent distant (bin/agent.js, à exécuter SUR la machine distante, pas ici) ---
# Ces variables ne sont PAS lues par server.js : elles servent uniquement à
# configurer un agent (voir docs/multi-server/README.md#installation-agent).
# Fournies au moment de l'enregistrement du serveur (onglet Serveurs, POST /api/servers).
# PM2_MONITOR_HUB_URL=https://monitor.example.com
# PM2_MONITOR_SERVER_KEY=srv_xxxxxxxxxxxxxxxxxxxxxxxx
# PM2_MONITOR_AGENT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PM2_MONITOR_AGENT_NAME=agent-prod-1

# --- Backup & Restore (lib/services/backup/, bin/backup.js, Phase 19) -----
# Clé de chiffrement (AES-256-GCM) dédiée aux secrets EMBARQUÉS DANS UN
# BACKUP (ex: secrets de providers de notification, si explicitement inclus
# à l'export via includeSecrets=true) — volontairement DISTINCTE de
# NOTIFICATIONS_ENCRYPTION_KEY, voir lib/services/backup/crypto.js.
# Optionnelle : sans elle, un export incluant des secrets échoue
# explicitement (message d'erreur clair) plutôt que de les exclure
# silencieusement ou de générer une clé éphémère — un backup doit rester
# lisible après un redémarrage du process qui l'a produit ou reçu.
# BACKUP_ENCRYPTION_KEY=change-moi-aussi

# Limite de taille du corps de requête JSON pour /api/backup uniquement
# (export/validate/restore) — un gros backup (beaucoup d'enregistrements
# et/ou secrets inclus) peut dépasser la limite par défaut d'Express
# (100 Ko, appliquée à toutes les autres routes, inchangée). Accepte les
# formats de `bytes` (ex: "20mb", "512kb"). Par défaut : 20mb.
# BACKUP_MAX_BODY_SIZE=20mb
