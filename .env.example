# Copie ce fichier en ".env" et adapte les valeurs.

# Port d'écoute du dashboard
PORT=4200

# --- Compte admin initial ------------------------------------------------
# Utilisés UNE SEULE FOIS, au tout premier démarrage, pour créer le compte
# administrateur (si la base d'utilisateurs est vide). Ensuite, la gestion
# des comptes se fait depuis l'UI (menu utilisateurs, admin uniquement) ou
# via `node bin/manage-users.js`. Ces variables peuvent être retirées du
# .env après le premier lancement, elles ne servent plus.
PM2_MONITOR_USER=admin
PM2_MONITOR_PASS=change-moi

# Pour désactiver complètement l'auth (déconseillé si le port est exposé) :
# PM2_MONITOR_DISABLE_AUTH=1

# Secret de signature des cookies de session. À définir explicitement en
# production (sinon un secret aléatoire est généré à chaque redémarrage,
# ce qui déconnecte tout le monde à chaque restart du process).
SESSION_SECRET=change-moi-aussi

# Passe à 1 si le dashboard est servi en HTTPS (cookies "secure")
# SESSION_COOKIE_SECURE=1

# Clé de chiffrement (AES-256-GCM) des secrets de providers de
# notification (mot de passe SMTP, webhook Discord/Slack, bot token
# Telegram…). Accepte n'importe quelle chaîne (dérivée en 32 octets via
# SHA-256). Si absente, une clé aléatoire est générée en mémoire au
# démarrage (avertissement affiché) : tout secret déjà stocké devient
# alors illisible au prochain redémarrage. Voir docs/notifications/README.md.
NOTIFICATIONS_ENCRYPTION_KEY=change-moi-egalement

# --- Base de données (comptes / permissions) ------------------------------
# DB_DRIVER=sqlite (par défaut) : fichier local, zéro dépendance externe,
# recommandé pour la grande majorité des installations.
DB_DRIVER=sqlite
# Chemin du fichier SQLite (par défaut : ./data/monitor.db)
# DB_SQLITE_PATH=./data/monitor.db

# DB_DRIVER=mysql : pour centraliser users/permissions dans un serveur
# MySQL/MariaDB existant. Décommente et adapte, puis installe la dépendance
# optionnelle avec `npm install mysql2` si elle n'est pas déjà présente.
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=pm2_monitor
# DB_PASS=change-moi
# DB_NAME=pm2_monitor

# --- Moteur d'alertes (lib/services/alerts/) ------------------------------
# Active/désactive le moteur d'alertes (1 = activé, 0 = désactivé).
# ALERTS_ENABLED=1

# Intervalle d'évaluation des règles d'alerte (en ms, par défaut 15s).
# ALERTS_EVAL_INTERVAL_MS=15000

# --- Historique des processus (lib/services/process-history/) -------------
# Active/désactive l'historique des processus (1 = activé, 0 = désactivé).
# PROCESS_HISTORY_ENABLED=1

# Intervalle de collecte des données d'historique (en ms, par défaut 15s).
# PROCESS_HISTORY_COLLECT_INTERVAL_MS=15000

# Intervalle de maintenance de l'historique (en ms, par défaut 1h).
# PROCESS_HISTORY_MAINTENANCE_INTERVAL_MS=3600000

# Période de rétention des données petites (en ms, par défaut 1h).
# PROCESS_HISTORY_SHORT_RETENTION_MS=3600000

# Période de rétention des données moyennes (en ms, par défaut 30j).
# PROCESS_HISTORY_MEDIUM_RETENTION_MS=2592000000

# Période de rétention des données longues (en ms, par défaut 90j).
# PROCESS_HISTORY_LONG_RETENTION_MS=7776000000

# Période de bucket des données moyennes (en ms, par défaut 30j).
# PROCESS_HISTORY_MEDIUM_BUCKET_MS=2592000000

# Période de bucket des données longues (en ms, par défaut 90j).
# PROCESS_HISTORY_LONG_BUCKET_MS=7776000000

# Période de rétention des données raw max span (en ms, par défaut 6h).
# PROCESS_HISTORY_RAW_MAX_SPAN_MS=21600000

# Période de rétention des données medium max span (en ms, par défaut 30j).
# PROCESS_HISTORY_MEDIUM_MAX_SPAN_MS=2592000000

# Nombre maximum de points de données dans une réponse API (par défaut 500).
# PROCESS_HISTORY_MAX_POINTS=500

# --- Timeline d'événements (lib/services/events/) --------------------------
# Active/désactive la timeline d'événements PM2 (1 = activé, 0 = désactivé).
# EVENTS_ENABLED=1

# Durée de conservation des événements avant purge automatique (en ms, par défaut 90j).
# EVENTS_RETENTION_MS=7776000000

# Intervalle du cycle de purge (en ms, par défaut 1h).
# EVENTS_MAINTENANCE_INTERVAL_MS=3600000
